# Copy to .env and fill in real values. Never commit .env.

NODE_ENV=development

# packages/server
PORT=8080
DATABASE_URL=postgres://postgres:postgres@localhost:5432/collab_editor
JWT_ACCESS_SECRET=replace-me
JWT_REFRESH_SECRET=replace-me

# Phase 21 — tombstone GC (Engine Spec §7.4/§7.7). All optional; commented-out
# values below are the built-in defaults (config.ts), shown here for discoverability.
# GC_UNDO_HORIZON_MAX_AGE_MS=300000
# GC_UNDO_HORIZON_MAX_OPS_PER_REPLICA=200
# GC_INTERVAL_MS=60000

# packages/client
VITE_API_BASE_URL=http://localhost:8080
VITE_WS_URL=ws://localhost:8080/v1/rt
