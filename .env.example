# Copy to .env and fill in real values. Never commit .env.

NODE_ENV=development

# packages/server
PORT=8080
DATABASE_URL=postgres://postgres:postgres@localhost:5432/collab_editor
JWT_ACCESS_SECRET=replace-me
JWT_REFRESH_SECRET=replace-me

# Phase 21 — tombstone GC (Engine Spec §7.4/§7.7). All optional; commented-out
# values below are the built-in defaults (config.ts), shown here for discoverability.
# GC_UNDO_HORIZON_MAX_AGE_MS=300000
# GC_UNDO_HORIZON_MAX_OPS_PER_REPLICA=200
# GC_INTERVAL_MS=60000

# Phase 26 — authentication (API Spec §4.1/§4.2). JWT_ACCESS_SECRET/
# JWT_REFRESH_SECRET above are REQUIRED (no safe default exists for a secret).
# Everything below is optional; commented-out values are the built-in
# defaults (config.ts) — disclosed, reasonable starting points, not
# spec-mandated numbers (except AUTH_ACCESS_TOKEN_TTL_MS, API Spec §4.1's own
# literal 15 minutes).
# AUTH_ACCESS_TOKEN_TTL_MS=900000
# AUTH_REFRESH_TOKEN_TTL_MS=2592000000
# AUTH_LOGIN_RATE_LIMIT_PER_IP_MAX=20
# AUTH_LOGIN_RATE_LIMIT_PER_IP_WINDOW_MS=900000
# AUTH_LOGIN_RATE_LIMIT_PER_ACCOUNT_MAX=5
# AUTH_LOGIN_RATE_LIMIT_PER_ACCOUNT_WINDOW_MS=900000

# packages/client
VITE_API_BASE_URL=http://localhost:8080
VITE_WS_URL=ws://localhost:8080/v1/rt
