{
  "name": "@collab-editor/client",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "React app and editor binding (DomWriter, input pipeline, cursor/presence rendering). See API/Protocol/Data Spec §7-9.",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p e2e/tsconfig.json",
    "build": "tsc -p tsconfig.json",
    "dev": "node scripts/serveApp.mjs",
    "test:e2e:build": "node e2e/build-bundle.mjs",
    "test:e2e": "pnpm run test:e2e:build && playwright test",
    "test:e2e:install": "playwright install chromium firefox webkit",
    "test:e2e:conv": "playwright test --project=convergence",
    "test:e2e:durableQueue": "playwright test --project=durableQueue",
    "test:benchmark": "vitest run --config vitest.benchmark.config.ts"
  },
  "dependencies": {
    "@collab-editor/engine": "workspace:*",
    "@collab-editor/protocol": "workspace:*",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@collab-editor/server": "workspace:*",
    "@playwright/test": "^1.48.0",
    "@types/node": "^20.16.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/ws": "^8.5.12",
    "esbuild": "^0.24.0",
    "fake-indexeddb": "^6.2.5",
    "fast-check": "^4.9.0",
    "jsdom": "^25.0.1",
    "typescript": "^5.6.3",
    "ws": "^8.18.0"
  }
}
