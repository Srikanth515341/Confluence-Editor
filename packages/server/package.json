{
  "name": "@collab-editor/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Express + WebSocket gateway, document coordinator, and persistence layer. See API/Protocol/Data Spec v1.0.",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/index.ts",
    "db:migrate": "dotenv -e ../../.env -- node-pg-migrate up -m migrations",
    "db:migrate:down": "dotenv -e ../../.env -- node-pg-migrate down -m migrations",
    "db:reset": "dotenv -e ../../.env -- node-pg-migrate down -m migrations 0 && dotenv -e ../../.env -- node-pg-migrate up -m migrations",
    "db:seed": "dotenv -e ../../.env -- tsx scripts/seed.ts",
    "admin": "dotenv -e ../../.env -- tsx scripts/admin.ts",
    "test:db": "dotenv -e ../../.env -- vitest run --config vitest.db.config.ts"
  },
  "dependencies": {
    "@collab-editor/engine": "workspace:*",
    "@collab-editor/protocol": "workspace:*",
    "argon2": "^0.45.1",
    "cookie": "^2.0.1",
    "express": "^4.21.1",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.13.1",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20.16.0",
    "@types/pg": "^8.11.10",
    "@types/ws": "^8.5.12",
    "dotenv-cli": "^7.4.4",
    "node-pg-migrate": "^7.9.1",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
