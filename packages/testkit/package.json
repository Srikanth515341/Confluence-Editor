{
  "name": "@collab-editor/testkit",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Fuzz harness, mutation-testing harness, network-fault proxy, and load harness. See Test Plan v1.0.",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build": "tsc -p tsconfig.json",
    "test:convergence": "vitest run --config vitest.convergence.config.ts",
    "test:properties": "vitest run --config vitest.properties.config.ts",
    "test:adversarial": "vitest run --config vitest.adversarial.config.ts",
    "test:mutation": "vitest run --config vitest.mutation.config.ts",
    "test:benchmark": "vitest run --config vitest.benchmark.config.ts"
  },
  "dependencies": {
    "@collab-editor/engine": "workspace:*",
    "@collab-editor/protocol": "workspace:*",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/ws": "^8.5.12",
    "fast-check": "^4.9.0",
    "typescript": "^5.6.3"
  }
}
