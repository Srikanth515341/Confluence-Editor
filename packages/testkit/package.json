{
  "name": "@collab-editor/testkit",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Fuzz harness, mutation-testing harness, network-fault proxy, and load harness. See Test Plan v1.0.",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build": "tsc -p tsconfig.json",
    "test:convergence": "vitest run --config vitest.convergence.config.ts"
  },
  "dependencies": {
    "@collab-editor/engine": "workspace:*"
  }
}
